char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
edges ::= "[" space (edges-item ("," space edges-item)*)? space "]"
edges-item ::= ref-defs-CombinedFact
edges-kv ::= "\"edges\"" space ":" space edges
extracted-entities ::= "[" space (extracted-entities-item ("," space extracted-entities-item)*)? space "]"
extracted-entities-item ::= ref-defs-CombinedEntity
extracted-entities-kv ::= "\"extracted_entities\"" space ":" space extracted-entities
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
ref-defs-CombinedEntity ::= "{" space ref-defs-CombinedEntity-name-kv "," space ref-defs-CombinedEntity-entity-type-id-kv space "}"
ref-defs-CombinedEntity-entity-type-id-kv ::= "\"entity_type_id\"" space ":" space integer
ref-defs-CombinedEntity-name-kv ::= "\"name\"" space ":" space string
ref-defs-CombinedFact ::= "{" space ref-defs-CombinedFact-source-entity-name-kv "," space ref-defs-CombinedFact-target-entity-name-kv "," space ref-defs-CombinedFact-relation-type-kv "," space ref-defs-CombinedFact-fact-kv ( "," space ( ref-defs-CombinedFact-episode-indices-kv ) )? space "}"
ref-defs-CombinedFact-episode-indices ::= "[" space (integer ("," space integer)*)? space "]"
ref-defs-CombinedFact-episode-indices-kv ::= "\"episode_indices\"" space ":" space ref-defs-CombinedFact-episode-indices
ref-defs-CombinedFact-fact-kv ::= "\"fact\"" space ":" space string
ref-defs-CombinedFact-relation-type-kv ::= "\"relation_type\"" space ":" space string
ref-defs-CombinedFact-source-entity-name-kv ::= "\"source_entity_name\"" space ":" space string
ref-defs-CombinedFact-target-entity-name-kv ::= "\"target_entity_name\"" space ":" space string
schema ::= "{" space extracted-entities-kv "," space edges-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
root ::= .* close ws schema | .*
close ::= "</think>"
ws ::= [ \t\r\n]+
